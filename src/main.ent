<!doctype html>
<html>
	<head>
		<title>Kasaka</title>
		<style>
			#export-png {
				position: fixed;
				top: 16px;
				right: 16px;
				z-index: 1;
				border: 1px solid #1f1f1f;
				border-radius: 6px;
				background: #efefef;
				color: #151515;
				cursor: pointer;
				font: 600 14px system-ui, sans-serif;
				padding: 10px 14px;
			}

			#export-png:hover {
				background: #ffffff;
			}

			#version-label {
				position: fixed;
				right: 10px;
				bottom: 8px;
				color: #000000;
				font: 11px system-ui, sans-serif;
			}
		</style>
	</head>
	<body style="margin: 0; background-color: #775c5c">
		<button id="export-png" type="button">Export PNG</button>
		<div id="container"></div>
		<div id="version-label">v0.1</div>
	</body>
	<script type="module" defer>
		const response = await fetch("http://127.0.0.1:8080/src/player.svg");
		const svgText = await response.text();
		const svg = new DOMParser().parseFromString(
			svgText,
			"image/svg+xml",
		).documentElement;
		const container = document.getElementById("container");
		const exportButton = document.getElementById("export-png");
		container.appendChild(svg);

		/** @type {{string: NodeListOf<SVGElement>}} */
		const dom = {
			colors: svg.querySelectorAll("[id^='colors'] > *"),
			icons: svg.querySelectorAll("[id^='icons'] > *"),
			shirt: svg.querySelectorAll("[id^='player'] [id^='shirt']"),
			pants: svg.querySelectorAll("[id^='player'] [id^='pants']"),
			socks: svg.querySelectorAll("[id^='player'] [id^='socks']"),
		};

		const shirtOptions = [...svg.querySelectorAll("#player > #shirt > *")];
		const shirtOptionsById = Object.fromEntries(
			shirtOptions.map((shirtOption) => {
				const shirtId =
					shirtOption.getAttribute("data-savage-id") || shirtOption.id;
				return [shirtId, shirtOption];
			}),
		);
		const shirtColorSlotsById = Object.fromEntries(
			shirtOptions.map((shirtOption) => {
				const shirtId =
					shirtOption.getAttribute("data-savage-id") || shirtOption.id;
				const colorElements = [
					...(shirtOption.matches("[fill]") ? [shirtOption] : []),
					...shirtOption.querySelectorAll("[fill]"),
				].filter((element) => element.getAttribute("fill") !== "none");
				const colorSlots = [];
				const colorSlotIndexes = new Map();

				for (const colorElement of colorElements) {
					const fill = colorElement.getAttribute("fill");
					if (!colorSlotIndexes.has(fill)) {
						colorSlotIndexes.set(fill, colorSlots.length);
						colorSlots.push([]);
					}
					colorSlots[colorSlotIndexes.get(fill)].push(colorElement);
				}

				return [shirtId, colorSlots];
			}),
		);

		let selected = null;
		let selectedShirt = "plain";
		let shirtColors = [null, null];

		const selectableItems = [
			{ type: "shirt", element: dom.shirt[0] },
			{ type: "socks", element: dom.socks[0] },
			{ type: "pants", element: dom.pants[0] },
		];

		const clearSelectionStyles = () => {
			for (const { element } of selectableItems) {
				element.style.stroke = "none";
				element.style["stroke-width"] = 2;
				element.style["stroke-dasharray"] = "none";
				element.style["stroke-linecap"] = "butt";
				element.style.filter = "none";
			}
		};

		const applySelectionStyles = (item) => {
			item.element.style.stroke = "white";
			item.element.style["stroke-width"] = 5;
			item.element.style["stroke-dasharray"] = "12 8";
			item.element.style["stroke-linecap"] = "butt";
			item.element.style.filter = "drop-shadow(0 0 1px black)";
		};

		const setSelected = (item) => {
			selected = item;
			clearSelectionStyles();
			if (selected) {
				applySelectionStyles(selected);
			}
		};

		const applyShirtColors = () => {
			const colorSlots = shirtColorSlotsById[selectedShirt] || [];
			for (const [index, color] of shirtColors.entries()) {
				if (color && colorSlots[index]) {
					for (const colorElement of colorSlots[index]) {
						colorElement.setAttribute("fill", color);
					}
				}
			}
		};

		const setShirtColor = (colorIndex, color) => {
			shirtColors[colorIndex] = color;
			applyShirtColors();
		};

		const setSelectedShirt = (shirtId) => {
			for (const shirtOption of shirtOptions) {
				shirtOption.style.display = "none";
			}

			const shirtOption = shirtOptionsById[shirtId];
			if (!shirtOption) {
				return;
			}

			shirtOption.style.display = "inline";
			selectedShirt = shirtId;
			applyShirtColors();
			if (selected?.type === "shirt") {
				applySelectionStyles(selected);
			}
		};

		setSelectedShirt(selectedShirt);

		const getPlayerExportBox = () => {
			const exportElements = [
				svg.querySelector("#player"),
				svg.querySelector("[id='player extras']"),
			].filter(Boolean);
			const boxes = exportElements.map((element) => element.getBBox());
			const minX = Math.min(...boxes.map((box) => box.x));
			const minY = Math.min(...boxes.map((box) => box.y));
			const maxX = Math.max(...boxes.map((box) => box.x + box.width));
			const maxY = Math.max(...boxes.map((box) => box.y + box.height));
			const padding = 24;

			return {
				x: minX - padding,
				y: minY - padding,
				width: maxX - minX + padding * 2,
				height: maxY - minY + padding * 2,
			};
		};

		const downloadUrl = (url, filename) => {
			const link = document.createElement("a");
			link.href = url;
			link.download = filename;
			document.body.appendChild(link);
			link.click();
			link.remove();
		};

		const exportPlayerPng = async () => {
			const box = getPlayerExportBox();
			const exportScale = 2;
			clearSelectionStyles();

			const exportSvg = svg.cloneNode(true);
			exportSvg.querySelector("#colors")?.remove();
			exportSvg.querySelector("#icons")?.remove();
			exportSvg.setAttribute("xmlns", "http://www.w3.org/2000/svg");
			exportSvg.setAttribute(
				"viewBox",
				`${box.x} ${box.y} ${box.width} ${box.height}`,
			);
			exportSvg.setAttribute("width", String(Math.ceil(box.width)));
			exportSvg.setAttribute("height", String(Math.ceil(box.height)));

			if (selected) {
				applySelectionStyles(selected);
			}

			const svgBlob = new Blob([new XMLSerializer().serializeToString(exportSvg)], {
				type: "image/svg+xml;charset=utf-8",
			});
			const svgUrl = URL.createObjectURL(svgBlob);
			const image = new Image();

			try {
				await new Promise((resolve, reject) => {
					image.onload = resolve;
					image.onerror = reject;
					image.src = svgUrl;
				});

				const canvas = document.createElement("canvas");
				canvas.width = Math.ceil(box.width * exportScale);
				canvas.height = Math.ceil(box.height * exportScale);
				const context = canvas.getContext("2d");
				context.drawImage(image, 0, 0, canvas.width, canvas.height);

				const pngUrl = canvas.toDataURL("image/png");
				downloadUrl(pngUrl, "Kasaka.png");
			} finally {
				URL.revokeObjectURL(svgUrl);
			}
		};

		exportButton.addEventListener("click", exportPlayerPng);

		document.body.addEventListener("click", (event) => {
			if ([document.body, container, svg].includes(event.target)) {
				setSelected(null);
			}
		});

		// Set mouse overs
		for (const items of [
			dom.colors,
			dom.icons,
			dom.shirt,
			dom.socks,
			dom.pants,
		]) {
			/** @type {SVGElement} */
			let item;
			for (item of items) {
				item.style["stroke-width"] = 2;
				item.addEventListener("mouseenter", (event) => {
					if (event.target !== selected?.element) {
						event.target.style.stroke = "silver";
					}
				});
				item.addEventListener("mouseleave", (event) => {
					if (event.target !== selected?.element) {
						event.target.style.stroke = "none";
					} else {
						applySelectionStyles(selected);
					}
				});
				if ([dom.shirt, dom.socks, dom.pants].includes(items)) {
					item.addEventListener("click", () => {
						setSelected(
							selectableItems.find(({ element }) => element === item),
						);
					});
				}
			}
		}

		for (const shirtIcon of dom.icons) {
			shirtIcon.addEventListener("click", () => {
				const shirtId =
					shirtIcon.getAttribute("data-savage-id") || shirtIcon.id;
				setSelectedShirt(shirtId);
			});
		}

		// set color onClicks
		for (const colorIcon of dom.colors) {
			colorIcon.addEventListener("click", (event) => {
				const color = colorIcon.getAttribute("fill");
				if (selected?.type === "shirt") {
					setShirtColor(0, color);
					return;
				}
				if (["pants", "socks"].includes(selected?.type)) {
					selected.element.setAttribute("fill", color);
					console.log(selected);
				}
			});
			colorIcon.addEventListener("contextmenu", (event) => {
				event.preventDefault();
				const color = colorIcon.getAttribute("fill");
				if (selected?.type === "shirt") {
					setShirtColor(1, color);
				}
			});
		}
	</script>
</html>
